@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
        
        <!-- Footer -->
        <footer class="footer bg-light border-top mt-5 py-3">
            <div class="container-fluid text-center">
                <div class="row">
                    <div class="col-12">
                        <p class="mb-1 text-muted">
                            <strong>Realizzato da Francesco Aiello</strong>
                        </p>
                        <p class="mb-1 small text-muted">
                            © 2025 - Quiz Tabelline
                        </p>
                        <p class="mb-0 small">
                            <a href="mailto:francescoaiello@gmail.com" class="text-decoration-none">
                                📧 francescoaiello@gmail.com
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </footer>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
