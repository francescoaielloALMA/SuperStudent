@page "/quiz"
@using TabellineVocali.Models
@using TabellineVocali.Services
@inject QuizService QuizService
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Quiz Tabelline - Allenamento Matematico</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="text-center mb-4">
                <h1 class="display-4 text-primary">🎯 Quiz Tabelline</h1>
                <p class="lead">Allena la tua mente con le moltiplicazioni!</p>
            </div>
        </div>
    </div>

    @if (!QuizService.HasActiveSession && !isSessionExpired)
    {
        <!-- Setup Session -->
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h3 class="card-title mb-4">⏱️ Configura Sessione</h3>
                        <div class="mb-3">
                            <label for="durata" class="form-label">Durata (minuti):</label>
                            <input type="number" class="form-control form-control-lg text-center" 
                                   id="durata" @bind="durataMinuti" min="1" max="60" />
                        </div>
                        <button class="btn btn-primary btn-lg" @onclick="StartSession">
                            🚀 Inizia Quiz
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (isSessionExpired)
    {
        <!-- Session Results -->
        <div class="row justify-content-center">
            <div class="col-md-10">
                @if (sessionStats != null)
                {
                    <SessionResults Stats="@sessionStats" />
                }
                else
                {
                    <div class="card">
                        <div class="card-body text-center">
                            <h3 class="text-warning">⚠️ Errore nel caricamento delle statistiche</h3>
                            <p>Non è possibile mostrare le statistiche della sessione.</p>
                            <button class="btn btn-primary" @onclick="ResetSession">
                                🔄 Nuova Sessione
                            </button>
                        </div>
                    </div>
                }
                <div class="text-center mt-4">
                    <button class="btn btn-primary btn-lg" @onclick="ResetSession">
                        🔄 Nuova Sessione
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Active Quiz -->
        <div class="row">
            <!-- Timer and Stats -->
            <div class="col-md-3">
                <div class="card mb-3">
                    <div class="card-body text-center">
                        <h5 class="card-title">⏰ Tempo Rimanente</h5>
                        <h2 class="@GetTimerCssClass()">@FormatTime(QuizService.CurrentSession?.TempoRimanente ?? TimeSpan.Zero)</h2>
                    </div>
                </div>
                
                <div class="card mb-3">
                    <div class="card-body">
                        <h6 class="card-title">📊 Statistiche</h6>
                        <div class="row text-center">
                            <div class="col-6">
                                <div class="text-success h4">@QuizService.CurrentSession?.Corrette</div>
                                <small>Corrette</small>
                            </div>
                            <div class="col-6">
                                <div class="text-danger h4">@QuizService.CurrentSession?.Sbagliate</div>
                                <small>Sbagliate</small>
                            </div>
                        </div>
                        <div class="text-center mt-2">
                            <div class="text-info h5">@(QuizService.CurrentSession?.AccuratezzaPercentuale.ToString("F1") ?? "0")%</div>
                            <small>Accuratezza</small>
                        </div>
                        <div class="text-center mt-2">
                            <div class="text-warning h5">🔥 @QuizService.CurrentSession?.StreakCorrente</div>
                            <small>Streak Attuale</small>
                        </div>
                    </div>
                </div>
                
                <div class="card">
                    <div class="card-body text-center">
                        <h6 class="card-title">🔄 Controlli</h6>
                        <button class="btn btn-danger btn-sm w-100" @onclick="ResetStats" 
                                title="Riavvia completamente la sessione con timer e statistiche resettati">
                            🔄 Riavvia Sessione
                        </button>
                        <small class="text-muted d-block mt-2">
                            Riavvia timer e azzera tutto
                        </small>
                    </div>
                </div>
            </div>

            <!-- Question Area -->
            <div class="col-md-6">
                <div class="card shadow-lg">
                    <div class="card-body text-center p-5">
                        <h2 class="display-3 mb-4">
                            @currentQuestion.a × @currentQuestion.b = ?
                        </h2>
                        

                        <div class="mb-4">
                            <input type="number" class="form-control form-control-lg text-center" 
                                   @bind="userAnswer" @bind:event="oninput" @onkeydown="HandleKeyPress" 
                                   placeholder="Inserisci la risposta..." />
                        </div>

                        @if (!string.IsNullOrEmpty(feedbackMessage))
                        {
                            <div class="alert @(isLastAnswerCorrect ? "alert-success" : "alert-danger") alert-dismissible">
                                @feedbackMessage
                            </div>
                        }


                        <div class="d-grid gap-2 d-md-block">
                            <button class="btn btn-success btn-lg" @onclick="SubmitAnswer">
                                ✅ Conferma Risposta
                            </button>
                        </div>



                        @if (tentativi > 0)
                        {
                            <div class="alert alert-warning mt-3">
                                Tentativo @(tentativi + 1) di 3
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Game Instructions -->
            <div class="col-md-3">
                <div class="card">
                    <div class="card-body">
                        <h6 class="card-title">📝 Come Giocare</h6>
                        <ul class="list-unstyled small">
                            <li>✅ Calcola il risultato della moltiplicazione</li>
                            <li>✅ Inserisci la risposta nel campo</li>
                            <li>✅ Premi INVIO o clicca "Conferma"</li>
                            <li>✅ Hai 3 tentativi per ogni domanda</li>
                            <li>⏰ Rispondi velocemente per un punteggio migliore</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int durataMinuti = 5;
    private (int a, int b) currentQuestion;
    private int? userAnswer;
    private string feedbackMessage = "";
    private bool isLastAnswerCorrect;
    private int tentativi = 0;
    private DateTime questionStartTime;
    private bool isSessionExpired = false;
    private SessionStats? sessionStats;
    private Timer? sessionTimer;

    protected override void OnInitialized()
    {
        // Inizializzazione base del componente
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Componente pronto
            StateHasChanged();
        }
    }





    private void StartSession()
    {
        Console.WriteLine($"🚀 DEBUG: Avvio sessione - Durata: {durataMinuti} minuti");
        QuizService.StartNewSession(durataMinuti);
        GenerateNewQuestion();
        StartSessionTimer();
        StateHasChanged();
        Console.WriteLine($"🎯 DEBUG: Sessione avviata - Prima domanda: {currentQuestion.a} x {currentQuestion.b}");
    }

    private void ResetSession()
    {
        // Termina la sessione se non è già stata terminata
        if (QuizService.HasActiveSession || QuizService.CurrentSession != null)
        {
            QuizService.EndSession();
        }
        
        isSessionExpired = false;
        sessionStats = null;
        StopSessionTimer();
        StateHasChanged();
    }

    private void ResetStats()
    {
        if (QuizService.HasActiveSession && QuizService.CurrentSession != null)
        {
            // Ottieni la durata della sessione corrente
            var durataMinuti = QuizService.CurrentSession.DurataMinuti;
            
            // Riavvia completamente la sessione (include reset del timer)
            QuizService.StartNewSession(durataMinuti);
            
            // Genera una nuova domanda
            GenerateNewQuestion();
            
            // Feedback all'utente
            feedbackMessage = "🔄 Sessione riavviata! Timer e statistiche resettati!";
            StateHasChanged();
            
            // Rimuovi il messaggio dopo 2 secondi
            Task.Delay(2000).ContinueWith(_ => 
            {
                if (feedbackMessage.StartsWith("🔄 Sessione riavviata!"))
                {
                    feedbackMessage = "";
                    InvokeAsync(StateHasChanged);
                }
            });
        }
    }

    private void GenerateNewQuestion()
    {
        currentQuestion = QuizService.GenerateQuestion();
        userAnswer = null;
        feedbackMessage = "";
        tentativi = 0;
        questionStartTime = DateTime.Now;
        StateHasChanged();
    }

    private async Task SubmitAnswer()
    {
        if (!userAnswer.HasValue) return;

        var tempoRisposta = (DateTime.Now - questionStartTime).TotalSeconds;
        var isCorrect = QuizService.SubmitAnswer(
            currentQuestion.a, 
            currentQuestion.b, 
            userAnswer.Value, 
            tempoRisposta, 
            tentativi + 1,
            false
        );

        isLastAnswerCorrect = isCorrect;

        if (isCorrect)
        {
            feedbackMessage = GetCorrectMessage();
            StateHasChanged();
            await Task.Delay(300);
            feedbackMessage = "";
            GenerateNewQuestion();
        }
        else
        {
            tentativi++;
            if (tentativi >= 3)
            {
                feedbackMessage = $"❌ Risposta sbagliata! La risposta corretta era: {currentQuestion.a * currentQuestion.b}";
                StateHasChanged();
                await Task.Delay(300);
                feedbackMessage = "";
                GenerateNewQuestion();
            }
            else
            {
                feedbackMessage = $"❌ Sbagliato! Riprova (tentativo {tentativi + 1} di 3)";
                userAnswer = null;
            }
        }

        StateHasChanged();
    }





    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            // Forza l'aggiornamento del binding prima di inviare
            await InvokeAsync(StateHasChanged);
            
            // Piccolo delay per assicurarsi che il binding sia completato
            await Task.Delay(10);
            
            if (userAnswer.HasValue)
            {
                await SubmitAnswer();
            }
        }
    }



    private string GetCorrectMessage()
    {
        var messages = new[] { "✅ Perfetto!", "✅ Bravo!", "✅ Ottimo!", "✅ Fantastico!", "✅ Corretto!" };
        var random = new Random();
        return messages[random.Next(messages.Length)];
    }

    private void StartSessionTimer()
    {
        sessionTimer = new Timer(CheckSessionExpired, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopSessionTimer()
    {
        sessionTimer?.Dispose();
        sessionTimer = null;
    }

    private void CheckSessionExpired(object? state)
    {
        if (QuizService.IsSessionExpired())
        {
            Console.WriteLine("🕒 DEBUG: Sessione scaduta, calcolando statistiche...");
            
            // Calcola le statistiche PRIMA di terminare la sessione
            sessionStats = QuizService.CalculateStats();
            Console.WriteLine($"📊 DEBUG: Statistiche calcolate - Corrette: {sessionStats?.Corrette}, Sbagliate: {sessionStats?.Sbagliate}");
            
            // NON chiamare EndSession() qui, sarà chiamato da ResetSession()
            isSessionExpired = true;
            StopSessionTimer();
            InvokeAsync(StateHasChanged);
        }
        else
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private string FormatTime(TimeSpan time)
    {
        if (time.TotalSeconds <= 0) return "00:00";
        return $"{(int)time.TotalMinutes:D2}:{time.Seconds:D2}";
    }

    private string GetTimerCssClass()
    {
        var tempoRimanente = QuizService.CurrentSession?.TempoRimanente ?? TimeSpan.Zero;
        
        if (tempoRimanente.TotalSeconds <= 10 && tempoRimanente.TotalSeconds > 0)
        {
            return "text-danger timer-blinking";
        }
        
        return "text-primary";
    }

    public ValueTask DisposeAsync()
    {
        try
        {
            StopSessionTimer();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"🚨 Error stopping session timer: {ex.Message}");
        }
        
        return ValueTask.CompletedTask;
    }
}

<style>
    .timer-blinking {
        animation: blink-timer 1s infinite;
        font-weight: bold;
    }

    @@keyframes blink-timer {
        0%, 50% {
            opacity: 1;
        }
        51%, 100% {
            opacity: 0.3;
        }
    }
</style>