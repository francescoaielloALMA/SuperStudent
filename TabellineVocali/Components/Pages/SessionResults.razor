@using TabellineVocali.Models
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@if (Stats == null)
{
    <div class="card">
        <div class="card-body text-center">
            <h3 class="text-warning">⚠️ Statistiche non disponibili</h3>
            <p>Non è possibile mostrare le statistiche della sessione.</p>
        </div>
    </div>
}
else
{
<div class="card shadow-lg">
    <div class="card-header bg-primary text-white text-center">
        <h2 class="mb-0">🎯 RIEPILOGO FINALE</h2>
    </div>
    <div class="card-body">
        <div class="row">
            <!-- Statistiche Generali -->
            <div class="col-md-6 mb-4">
                <h5 class="text-primary">📊 STATISTICHE GENERALI</h5>
                <div class="row text-center">
                    <div class="col-4">
                        <div class="bg-success text-white rounded p-3">
                            <h3>@Stats.Corrette</h3>
                            <small>Corrette</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-danger text-white rounded p-3">
                            <h3>@Stats.Sbagliate</h3>
                            <small>Sbagliate</small>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="bg-info text-white rounded p-3">
                            <h3>@Stats.AccuratezzaPercentuale.ToString("F1")%</h3>
                            <small>Accuratezza</small>
                        </div>
                    </div>
                </div>
                <div class="row text-center mt-3">
                    <div class="col-6">
                        <div class="bg-secondary text-white rounded p-2">
                            <h5>@(Stats.Corrette + Stats.Sbagliate)</h5>
                            <small>Totale Domande</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-primary text-white rounded p-2">
                            <h5>@Stats.StreakMassimo</h5>
                            <small>Best Streak</small>
                        </div>
                    </div>
                </div>
                <div class="row text-center mt-3">
                    <div class="col-6">
                        <div class="bg-warning text-dark rounded p-2">
                            <h5>@Stats.TentativiTotali</h5>
                            <small>Tentativi Totali</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-dark text-white rounded p-2">
                            <h5>@Stats.TentativiErrati</h5>
                            <small>Tentativi Errati</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Velocità -->
            <div class="col-md-6 mb-4">
                <h5 class="text-primary">⚡ ANALISI VELOCITÀ</h5>
                <ul class="list-unstyled">
                    <li><strong>⏱️ Tempo medio:</strong> @Stats.TempoMedio.ToString("F2")s</li>
                    @if (Stats.TempoMinimo > 0)
                    {
                        <li><strong>🏃 Record velocità:</strong> @Stats.TempoMinimo.ToString("F2")s</li>
                    }
                    <li><strong>🐌 Tempo massimo:</strong> @Stats.TempoMassimo.ToString("F2")s</li>
                    @if (Stats.TempoMedio > 0)
                    {
                        <li><strong>🚀 Ritmo:</strong> @((60.0 / Stats.TempoMedio).ToString("F1")) risposte/min</li>
                    }
                </ul>
            </div>
        </div>

        <!-- Analisi Efficienza -->
        <div class="row mb-4">
            <div class="col-12">
                <h5 class="text-primary">🎯 ANALISI EFFICIENZA</h5>
                <div class="card">
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <h6>📝 Efficienza Risposta</h6>
                                <span class="badge bg-success fs-6">
                                    @((Stats.TentativiTotali > 0 ? (Stats.Corrette * 100.0 / Stats.TentativiTotali) : 0).ToString("F1"))%
                                </span>
                                <small class="d-block text-muted">Corrette/Tentativi totali</small>
                            </div>
                            <div class="col-md-3">
                                <h6>🎯 Ratio Successo</h6>
                                <span class="badge bg-info fs-6">
                                    @((Stats.TentativiErrati > 0 ? (Stats.Corrette / (double)Stats.TentativiErrati).ToString("F2") : "∞"))
                                </span>
                                <small class="d-block text-muted">Corrette per errore</small>
                            </div>
                            <div class="col-md-3">
                                <h6>💪 Tenacia</h6>
                                <span class="badge bg-warning text-dark fs-6">
                                    @((Stats.Corrette > 0 ? (Stats.TentativiTotali / (double)Stats.Corrette).ToString("F1") : "0"))
                                </span>
                                <small class="d-block text-muted">Tentativi per successo</small>
                            </div>
                            <div class="col-md-3">
                                <h6>🔄 Perseveranza</h6>
                                <span class="badge bg-secondary fs-6">
                                    @((Stats.Sbagliate > 0 ? (Stats.TentativiErrati / (double)Stats.Sbagliate).ToString("F1") : "0"))
                                </span>
                                <small class="d-block text-muted">Ritentativi per sbaglio</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Distribuzione Tempi -->
            <div class="col-md-6 mb-4">
                <h5 class="text-primary">📈 DISTRIBUZIONE TEMPI</h5>
                <div class="progress mb-2" style="height: 25px;">
                    @{
                        var totale = Stats.DistribuzioneTempo.Sotto1s + Stats.DistribuzioneTempo.Da1a2s + 
                                    Stats.DistribuzioneTempo.Da2a3s + Stats.DistribuzioneTempo.Sopra3s;
                        var percentSotto1s = totale > 0 ? (Stats.DistribuzioneTempo.Sotto1s * 100.0 / totale) : 0;
                        var percent1a2s = totale > 0 ? (Stats.DistribuzioneTempo.Da1a2s * 100.0 / totale) : 0;
                        var percent2a3s = totale > 0 ? (Stats.DistribuzioneTempo.Da2a3s * 100.0 / totale) : 0;
                        var percentSopra3s = totale > 0 ? (Stats.DistribuzioneTempo.Sopra3s * 100.0 / totale) : 0;
                    }
                    <div class="progress-bar bg-success" style="width: @(percentSotto1s)%">
                        @Stats.DistribuzioneTempo.Sotto1s &lt;1s
                    </div>
                    <div class="progress-bar bg-info" style="width: @(percent1a2s)%">
                        @Stats.DistribuzioneTempo.Da1a2s 1-2s
                    </div>
                    <div class="progress-bar bg-warning" style="width: @(percent2a3s)%">
                        @Stats.DistribuzioneTempo.Da2a3s 2-3s
                    </div>
                    <div class="progress-bar bg-danger" style="width: @(percentSopra3s)%">
                        @Stats.DistribuzioneTempo.Sopra3s &gt;3s
                    </div>
                </div>
            </div>

            <!-- Streak -->
            <div class="col-md-6 mb-4">
                <h5 class="text-primary">🔥 STREAK E PROGRESSO</h5>
                <ul class="list-unstyled">
                    <li><strong>🏆 Streak massimo:</strong> @Stats.StreakMassimo risposte consecutive</li>
                    @if (Stats.TrendAccuratezza != 0)
                    {
                        <li><strong>📈 Trend:</strong> 
                            @if (Stats.TrendAccuratezza > 0)
                            {
                                <span class="text-success">📈 MIGLIORAMENTO! (+@Stats.TrendAccuratezza.ToString("F1")%)</span>
                            }
                            else
                            {
                                <span class="text-warning">📉 Calo prestazioni (@Stats.TrendAccuratezza.ToString("F1")%)</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>

        @if (Stats.TabellePiuDifficili.Any())
        {
            <div class="row">
                <div class="col-md-6 mb-4">
                    <h5 class="text-primary">❌ TABELLINE PIÙ DIFFICILI</h5>
                    <ul class="list-unstyled">
                        @foreach (var item in Stats.TabellePiuDifficili)
                        {
                            <li>🔴 <strong>@item.Key:</strong> @item.Value errori</li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (Stats.TabelleVeloci.Any())
        {
            <div class="row">
                <div class="col-md-6 mb-4">
                    <h5 class="text-primary">⚡ TABELLINE PIÙ VELOCI</h5>
                    <ul class="list-unstyled">
                        @foreach (var item in Stats.TabelleVeloci)
                        {
                            <li>🟢 <strong>@item.Key:</strong> @item.Value.ToString("F2")s medio</li>
                        }
                    </ul>
                </div>
                
                <!-- Analisi Aggiuntive -->
                <div class="col-md-6 mb-4">
                    <h5 class="text-primary">📋 ANALISI DETTAGLIATE</h5>
                    <ul class="list-unstyled">
                        @{
                            var totaleRisposte = Stats.Corrette + Stats.Sbagliate;
                            var percentualeCorrette = totaleRisposte > 0 ? (Stats.Corrette * 100.0 / totaleRisposte) : 0;
                            var percentualeSbagliate = totaleRisposte > 0 ? (Stats.Sbagliate * 100.0 / totaleRisposte) : 0;
                        }
                        <li><strong>📊 Rapporto risposte:</strong> @Stats.Corrette:@Stats.Sbagliate</li>
                        @if (Stats.TempoMedio > 0)
                        {
                            <li><strong>⚡ Efficienza:</strong> @((Stats.AccuratezzaPercentuale / Stats.TempoMedio).ToString("F1")) punti/sec</li>
                        }
                        @if (Stats.DistribuzioneTempo.Sotto1s > 0)
                        {
                            <li><strong>🚀 Risposte rapide:</strong> @Stats.DistribuzioneTempo.Sotto1s (&lt;1s)</li>
                        }
                        @if (totaleRisposte > 0)
                        {
                            <li><strong>🎯 Ratio successo:</strong> @((double)Stats.Corrette / totaleRisposte * 100).ToString("F1")%</li>
                        }
                    </ul>
                </div>
            </div>
        }

        <!-- Valutazione Complessiva -->
        <div class="row">
            <div class="col-12 text-center mb-4">
                <div class="card bg-light">
                    <div class="card-body">
                        <h3 class="text-primary">🏆 VALUTAZIONE COMPLESSIVA</h3>
                        <h2 class="text-success">@Stats.PunteggioComplessivo.ToString("F1")/100</h2>
                        <h4 class="text-primary">@Stats.Livello</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Achievements -->
        @if (Stats.Achievements.Any())
        {
            <div class="row">
                <div class="col-12">
                    <h5 class="text-primary">🏅 ACHIEVEMENTS SBLOCCATI</h5>
                    <div class="row">
                        @foreach (var achievement in Stats.Achievements)
                        {
                            <div class="col-md-6 mb-2">
                                <div class="badge bg-warning text-dark p-3 w-100">
                                    @achievement
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
}

@code {
    [Parameter] public SessionStats Stats { get; set; } = new();
}