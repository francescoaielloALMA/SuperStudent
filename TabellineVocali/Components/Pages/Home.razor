@page "/"

<PageTitle>Quiz Tabelline con Riconoscimento Vocale</PageTitle>

<div class="container-fluid">
    <div class="text-center mb-5">
        <h1 class="display-1">🎯</h1>
        <h1 class="display-4 text-primary">Quiz Tabelline</h1>
        <p class="lead">Impara le tabelline con il riconoscimento vocale!</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-body text-center p-5">
                    <h2 class="text-primary mb-4">🚀 Inizia il tuo allenamento</h2>
                    <p class="lead mb-4">
                        Metti alla prova le tue conoscenze delle tabelline di moltiplicazione con la nostra app interattiva!
                    </p>
                    
                    <div class="row text-center mb-4">
                        <div class="col-md-4">
                            <div class="feature-icon">🎤</div>
                            <h5>Riconoscimento Vocale</h5>
                            <p>Rispondi con la voce per un'esperienza più naturale</p>
                        </div>
                        <div class="col-md-4">
                            <div class="feature-icon">📊</div>
                            <h5>Statistiche Avanzate</h5>
                            <p>Traccia i tuoi progressi con analisi dettagliate</p>
                        </div>
                        <div class="col-md-4">
                            <div class="feature-icon">🏆</div>
                            <h5>Achievements</h5>
                            <p>Sblocca traguardi e migliora le tue prestazioni</p>
                        </div>
                    </div>

                    <a href="/quiz" class="btn btn-primary btn-lg">
                        🎯 Inizia Quiz
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">📝 Come Funziona</h5>
                    <ol>
                        <li>Imposta la durata della sessione</li>
                        <li>Risolvi le moltiplicazioni che appaiono</li>
                        <li>Usa la voce o la tastiera per rispondere</li>
                        <li>Visualizza le tue statistiche alla fine</li>
                    </ol>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">🎤 Comandi Vocali</h5>
                    <ul>
                        <li>Pronuncia chiaramente il numero</li>
                        <li>Es: "ventiquattro", "trentasei"</li>
                        <li>Oppure cifre singole: "2-4", "3-6"</li>
                        <li>Assicurati che il microfono sia attivo</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .feature-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
    }
</style>
