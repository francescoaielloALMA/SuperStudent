{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "dotnet",
			"args": ["build", "RiconoscimentoVocale.sln"],
			"group": "build",
			"problemMatcher": ["$msCompile"]
		},
		{
			"label": "run-blazor-app",
			"type": "shell",
			"command": "dotnet run",
			"options": {
				"cwd": "${workspaceFolder}/TabellineVocali"
			},
			"isBackground": true,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}